# From your Entra ID app registration (see README)
OC_CLIENT_ID=00000000-0000-0000-0000-000000000000
OC_TENANT_ID=00000000-0000-0000-0000-000000000000

# Open/click tracking (optional). `./oc tracker-setup` generates KEY and SECRET.
# Add OC_TRACK_URL only after the Cloudflare worker is deployed and answering.
# OC_TRACK_URL=https://links.yourdomain.com
# OC_TRACK_KEY=
# OC_TRACK_SECRET=

# Claude drafts for LinkedIn comments (optional): https://platform.claude.com → API keys
# ANTHROPIC_API_KEY=
